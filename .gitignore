# Track only the reusable starter, never the surrounding WordPress install.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/scripts/
!/tests/
!/wp-content/
/.inkwell-install.json
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/inkwell/
**/node_modules/
**/dist/
**/dev.config.json
**/.env
**/.env.*
**/*.log
**/*.tgz
**/.DS_Store
**/Thumbs.db
